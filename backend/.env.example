# ── App workspace (fevm-leticia-santos-stable) ─────────────────
# This is the workspace where the client app stores its own settings (workspace_envs table).
DATABRICKS_HOST=https://fevm-leticia-santos-stable.cloud.databricks.com

# --- Authentication (choose ONE) ---

# Option 1: Service Principal OAuth M2M (recommended)
DATABRICKS_CLIENT_ID=your-sp-application-id
DATABRICKS_CLIENT_SECRET=your-sp-oauth-secret

# Option 2: PAT token (local dev)
# DATABRICKS_TOKEN=your-pat-token

# SQL Warehouse ID in the app workspace (used to store/read settings)
# Workspace → SQL → SQL Warehouses → copy the ID
DATABRICKS_WAREHOUSE_ID=your-warehouse-id

# Unity Catalog — where the client app stores its settings table
# catalog.schema used for workspace_envs table
APP_CATALOG=leticia_santos_stable_catalog
APP_SCHEMA=corp_agent_client

# CORS
CORS_ORIGINS=["http://localhost:3001"]
